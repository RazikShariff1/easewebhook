APP_NAME=easewebhook
HTTP_PORT=8000
METRICS_PORT=2121
LOG_LEVEL=INFO

# Supabase Postgres via IPv4 session pooler
# (db.<ref>.supabase.co is IPv6-only and unreachable from this network)
DB_DIALECT=postgres
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.prcbkeoilawbarjhgfoq
DB_PASSWORD=<your-db-password>
DB_NAME=postgres
DB_SSL_MODE=require
DB_MAX_OPEN_CONNECTION=10
DB_MAX_IDLE_CONNECTION=5

# Public base URL used to build source URLs (https://hkdk.events/<key> equivalent)
PUBLIC_INGEST_BASE_URL=http://localhost:8000/e

# Delivery worker
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=20
DELIVERY_TIMEOUT_SECONDS=30

ACCESS_CONTROL_ALLOW_ORIGIN=*

# Auth
# Google OAuth "Web application" client ID (same one oc-a-fe/admine-fe uses). Public, not a secret.
GOOGLE_CLIENT_ID=624904373513-s4r7hlqf396051t6op93qr8cgbt73s6h.apps.googleusercontent.com
# HS256 key for session tokens (>= 32 chars): openssl rand -hex 32
JWT_SECRET=<random-64-hex>
